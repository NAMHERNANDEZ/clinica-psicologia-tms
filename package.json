{
  "name": "clinica-psicologia-tms",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
"build": "vite build",
  "test:frontend": "vitest run",
  "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "audit": "node scripts/pre-deploy-audit.cjs",
    "gate": "node scripts/pre-deploy-gate.cjs",
    "smoke:chat": "node scripts/smoke-chat-matrix.cjs",
    "e2e:ui": "node scripts/e2e-ui-edge.cjs",
    "e2e:repeat": "node scripts/e2e-repeat.cjs",
    "release:verify": "node scripts/pre-deploy-gate.cjs && node scripts/smoke-chat-matrix.cjs && node scripts/e2e-ui-edge.cjs && node scripts/e2e-repeat.cjs",
    "deploy": "node scripts/pre-deploy-audit.cjs && vite build && wrangler pages deploy dist --project-name clinica-psicologia-tms"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.17",
    "@fullcalendar/react": "^6.1.17",
    "@fullcalendar/timegrid": "^6.1.17",
    "@supabase/supabase-js": "^2.57.4",
    "@types/three": "^0.185.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@beast-course/video-pipeline": "^0.1.1",
    "@eslint/js": "^9.9.1",
    "@gltf-transform/cli": "^4.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "edge-tts": "^1.0.1",
    "elevenlabs-node": "^2.0.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "globals": "^15.9.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.0",
    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.0",
    "wrangler": "^4.107.1"
  }
}
