{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "ask",
      "git push *": "ask",
      "wrangler deploy *": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
