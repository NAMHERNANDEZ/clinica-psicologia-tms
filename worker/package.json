{
  "name": "clinica-tms-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.js",
    "check:db": "node scripts/check-db.js",
    "db:init": "wrangler d1 execute clinica-tms-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute clinica-tms-db --file=./schema.sql --remote",
    "db:reset": "wrangler d1 execute clinica-tms-db --file=./schema.sql --yes",
    "db:reset:remote": "wrangler d1 execute clinica-tms-db --file=./schema.sql --yes --remote",
    "setup": "powershell -File deploy.ps1",
    "seed": "wrangler d1 execute clinica-tms-db --file=./seed.sql --remote",
    "health": "curl -s https://clinica-tms-api.terapiamagneticatranscraneal.workers.dev/api/health",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:security": "node scripts/security-check.js",
    "check:compliance": "node scripts/compliance-check.js",
    "check:migrations": "node scripts/migration-check.js",
    "check:remote": "node scripts/check-remote-migrations.js",
    "smoke:leads": "node scripts/smoke-test-leads.js",
    "deploy:production": "powershell -File scripts/deploy-production.ps1",
    "pipeline": "powershell -File scripts/pipeline.ps1",
    "pipeline:skip-deploy": "powershell -File scripts/pipeline.ps1 -SkipDeploy",
    "pipeline:skip-tests": "powershell -File scripts/pipeline.ps1 -SkipTests"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.0.0"
  }
}
